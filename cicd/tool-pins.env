## Tool versions the pipeline was last checked with. cicd.bash warns when the
## box has something else, so a lint result that changed can be traced to the
## tool rather than the code. Rust is pinned by source/rust/rust-toolchain.toml.
PIN_GO="go1.26.2"
PIN_STATICCHECK="2026.1"
PIN_SHELLCHECK="0.11.0"
PIN_RUFF="0.15.22"
PIN_GCC="14.2.0"
PIN_GCC15="15.2.0"
PIN_CLANG_FORMAT="21.1.8"
PIN_CLANG_TIDY="22.1.8"
PIN_CTOOLS_IMAGE="debian:unstable-slim@sha256:c08a0224cfc8b218e619427b09aac70939ec5ac68d91a58a558b7c20e5f0d280"
PIN_GCC15_PACKAGE="15.3.0-4"
PIN_GCC15_CONTAINER="15.3.0"
PIN_CLANG_PACKAGE="1:22.1.8-3"
PIN_HEAPTRACK_PACKAGE="1.5.0+dfsg1+git20260219.f16e8d3-2+b2"
PIN_HEAPTRACK="1.6.80"
PIN_MINGW_PACKAGE="16.2.0-1+29"
PIN_MINGW_HEADERS_PACKAGE="14.0.0-1"
PIN_MINGW_CONTAINER="16-win32"
PIN_CODEQL="2.26.2"
PIN_CODEQL_SHA256="f2a7f47f049b9de51977c02c7900b6e2af7587b50aef530a68975a97b136dfd4"
PIN_CODEQL_QUERY_COMMIT="03a143d69e45b6e3d3655b8200cfe2b85de91436"
## The Go, Rust and Python image (Lang.Dockerfile), on the C image's base.
## Rust's toolchain comes from source/rust/rust-toolchain.toml.
PIN_GO_SHA256="990e6b4bbba816dc3ee129eaeaf4b42f17c2800b88a2166c265ac1a200262282"
PIN_RUSTUP="1.29.1"
PIN_RUSTUP_SHA256="dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71"
PIN_RUFF_SHA256="365523eb91d9224e1bcb03b022fbf0facb8f9e23792a2c53d9d4b3924bdbdebb"
## python3 is the metapackage. Its version is not the interpreter's, which python3.14 pins.
PIN_PYTHON_PACKAGE="3.14.8-1"
