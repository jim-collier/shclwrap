## The shcl.py files the Python wrapper is checked against: the commit, and
## the file's sha256. cicd/cicd.bash fetches 3.0's by commit into cicd/cache/
## and refuses a file that doesn't match. 3.0 is the same commit Go, Rust, and
## C pin.
SHCL3_PY_REV="2174f0d94127bb5ae1024652a923ae2f7413c89b"
SHCL3_PY_SHA256="0d5a758e5c04adbb3bbb08b7b05ae69cba6da911f493c9033bc66c4e6ff11e14"
## 2.0 is the v2.0.0 tag's shcl.py, kept as _shclw_shcl2.py for the upgrade
## check. cicd checks the copy against this.
SHCL2_PY_REV="fd1068a629701068f07a197de45212d267c20f46"
SHCL2_PY_SHA256="af99fe7953a44d20a7f9300d4a7d9df7d5ae3537b997ab38fe93276bb60f31cc"
