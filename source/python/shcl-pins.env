SHCL3_PY_SHA256="9a474db87eb75c73d530ffd2100b97384ed8e7b0ec774c82670195fbb48a8b9b"
## 2.0 is the v2.0.0 tag's shcl.py, kept as _shclw_shcl2.py for the upgrade
## check. cicd checks the copy against this.
SHCL2_PY_REV="fd1068a629701068f07a197de45212d267c20f46"
