## The shcl.h files the C build is checked against: the commit, and the file's
## sha256. cicd/cicd.bash fetches each by commit into cicd/cache/ and refuses a
## file that doesn't match. 3.0 is the same commit Go and Rust pin.
SHCL3_REV="2174f0d94127bb5ae1024652a923ae2f7413c89b"
SHCL3_SHA256="ee79911893b54414ffb3d02d456c8d88d258aa4bd48dbdd0c87e72ec969da97e"
## 2.0 is the v2.0.0 tag's commit. The 3.0 build has it too, for the upgrade
## check (shclw3_v2.c).
SHCL2_REV="fd1068a629701068f07a197de45212d267c20f46"
SHCL2_SHA256="7df042f27ce48b5f34062f81b442f4d5359bd36e3508bb566167472559ba1e50"
